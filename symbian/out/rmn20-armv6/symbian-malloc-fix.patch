         if ((optimizationMask & HC_OPT_PEEPHOLE) != 0)
         {
-            peepholeIdentityRepackStore(lst);
+            peepholeIdentityRepackStore(mgr, lst);
             if ((optimizationMask & HC_OPT_DEAD_CODE) != 0)
                 deadCodeElimination(mgr, lst);
         }
@@ -4532,7 +4536,7 @@ static int compileInternal(HCArena_s *mgr, void **output, HCInstr_s *emuDst,
 
         if ((optimizationMask & HC_OPT_PEEPHOLE) != 0)
         {
-            peepholeIdentityRepackStore(lst);
+            peepholeIdentityRepackStore(mgr, lst);
