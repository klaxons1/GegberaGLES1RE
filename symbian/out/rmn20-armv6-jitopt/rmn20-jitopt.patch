diff --git a/src/gerbera/hc/hcSchedule.c b/src/gerbera/hc/hcSchedule.c
new file mode 100644
index 0000000..243e185
--- /dev/null
+++ b/src/gerbera/hc/hcSchedule.c
@@ -0,0 +1,437 @@
+/* hcSchedule.c - register-pressure driven instruction scheduling of HC IR.
+ *
+ * Not part of the original Gerbera compiler (ARM11 performance work).
+ *
+ * The pixel-pipeline bytecode emits HC IR "breadth first": every colour
+ * interpolant is shifted down, then every texel channel is extracted, then
+ * every multiply is issued and so on. That order keeps a dozen temporaries
+ * alive at the same time, and with 13 allocatable ARM registers the graph
+ * colouring allocator then spills the loop-carried interpolants (a load, a
+ * load + add + store per pixel each).
+ *
+ * HC_pressureSchedule() reorders the straight-line part of every basic
+ * block with a bottom-up list scheduler that minimises the number of live
+ * values (Sethi-Ullman style: a node is chosen when it frees the most
+ * registers, ties continue the expression tree that was started last). The
+ * dependence graph keeps every true/anti/output register dependence and the
+ * order of conflicting memory operations, so the program semantics are
+ * unchanged; only the evaluation order of independent expressions moves.
+ * Latency hiding is left to the target backend scheduler that runs on the
+ * final machine code.
+ */
+#include "gerbera/hc/hcSchedule.h"
+#include "gerbera/hc/hcOpcode.h"
+
+#include <string.h>
+
+#define SCHED_MAX_BLOCK 256
+
+typedef struct SchedNode_s
+{
+    int nUses;
+    int uses[3];       /* register numbers */
+    int useVal[3];     /* producing node index, or -1 - vreg for live-in */
+    int def;           /* register number or -1 */
+    int defLiveOut;    /* value stays live after the block */
+    int nSucc;         /* unscheduled successors */
+    int memKind;       /* 0 none, 1 load, 2 store */
+    int memBase;
+    int memImm;        /* -1 when register indexed */
+    int bornAt;        /* bottom-up schedule step at which the value became live */
+} SchedNode_s;
+
+static int schedIsPlain(HCInstr_s *instr)
+{
+    int op = HC_getOpcodeOper(instr);
+    if (op == HCOP_NOP || op == HCOP_LABEL || op == HCOP_EOP || op == HCOP_ANSA)
+        return 0;
+    if (op >= HCOP_FILLB && op <= HCOP_FILLD)
+        return 0;
+    if (HC_isBranchOp(op) != 0)
+        return 0;
+    return 1;
+}
+
+static int schedMemConflict(const SchedNode_s *a, const SchedNode_s *b)
+{
+    if (a->memKind == 0 || b->memKind == 0)
+        return 0;
+    if (a->memKind == 1 && b->memKind == 1)
+        return 0;
+    /* Hard register 0 is the parameter/spill frame pointer; nothing else
+     * addresses that memory. Frame slots with different offsets are
+     * disjoint (all accesses are word aligned within their own slot). */
+    if ((a->memBase == 0) != (b->memBase == 0))
+        return 0;
+    if (a->memBase == 0 && b->memBase == 0 && a->memImm >= 0 && b->memImm >= 0)
+        return a->memImm == b->memImm;
+    return 1;
+}
+
+/* Add a dependence edge pred -> succ (pred must stay before succ). */
+#define ADJ_ROW(n) (((n) + 7) >> 3)
+#define ADJ_TEST(adj, n, p, s) ((adj)[(p) * ADJ_ROW(n) + ((s) >> 3)] & (1u << ((s) & 7)))
+
+static void schedEdge(unsigned char *adj, int n, SchedNode_s *nodes, int pred, int succ)
+{
+    if (pred < 0 || pred == succ)
+        return;
+    if (!ADJ_TEST(adj, n, pred, succ))
+    {
+        adj[pred * ADJ_ROW(n) + (succ >> 3)] |= (unsigned char)(1u << (succ & 7));
+        nodes[pred].nSucc++;
+    }
+}
+
+static int schedValueLive(const unsigned char *liveVal, const unsigned char *liveIn, int val)
+{
+    return val >= 0 ? liveVal[val] : liveIn[-1 - val];
+}
+
+static void scheduleRange(HCArena_s *mgr, HCInstr_s *lst, int start, int end,
+                          const unsigned short *totalUses, int numRegs, int nHardRegs)
+{
+    int n = end - start;
+    int topMark;
+    SchedNode_s *nodes;
+    unsigned char *adj;
+    int *lastDef;
+    int *order;
+    unsigned char *scheduled;
+    unsigned char *liveVal;
+    unsigned char *liveIn;    /* indexed by register: live-in value currently live */
+    unsigned char *alwaysLive;
+    unsigned short *rangeUses;
+    HCInstr_s *copy;
+    int i, k, j, step;
+
+    if (n < 3)
+        return;
+    if (n > SCHED_MAX_BLOCK)
+    {
+        int s0;
+        for (s0 = start; s0 < end; s0 += SCHED_MAX_BLOCK)
+            scheduleRange(mgr, lst, s0, (end - s0 > SCHED_MAX_BLOCK) ? s0 + SCHED_MAX_BLOCK : end,
+                          totalUses, numRegs, nHardRegs);
+        return;
+    }
+
+    topMark = HCArena_markTop(mgr);
+    nodes = (SchedNode_s *)HCArena_allocTop(mgr, (unsigned int)(n * sizeof(SchedNode_s)));
+    adj = (unsigned char *)HCArena_allocTop(mgr, (unsigned int)(n * ADJ_ROW(n)));
+    lastDef = (int *)HCArena_allocTop(mgr, (unsigned int)(numRegs * sizeof(int)));
+    order = (int *)HCArena_allocTop(mgr, (unsigned int)(n * sizeof(int)));
+    scheduled = (unsigned char *)HCArena_allocTop(mgr, (unsigned int)n);
+    liveVal = (unsigned char *)HCArena_allocTop(mgr, (unsigned int)n);
+    liveIn = (unsigned char *)HCArena_allocTop(mgr, (unsigned int)numRegs);
+    alwaysLive = (unsigned char *)HCArena_allocTop(mgr, (unsigned int)numRegs);
+    rangeUses = (unsigned short *)HCArena_allocTop(mgr, (unsigned int)(numRegs * sizeof(unsigned short)));
+    copy = (HCInstr_s *)HCArena_allocTop(mgr, (unsigned int)(n * sizeof(HCInstr_s)));
+    memset(adj, 0, (size_t)n * (size_t)ADJ_ROW(n));
+    memset(scheduled, 0, (size_t)n);
+    memset(liveVal, 0, (size_t)n);
+    memset(liveIn, 0, (size_t)numRegs);
+    memset(alwaysLive, 0, (size_t)numRegs);
+    memset(rangeUses, 0, (size_t)numRegs * sizeof(unsigned short));
+    for (k = 0; k < numRegs; ++k)
+        lastDef[k] = -1;
+
+    /* nodes, value binding, register dependences */
+    for (i = 0; i < n; ++i)
+    {
+        HCInstr_s *instr = &lst[start + i];
+        SchedNode_s *nd = &nodes[i];
+        int op = HC_getOpcodeOper(instr);
+        int u[4];
+
+        memset(nd, 0, sizeof(*nd));
+        nd->nUses = HC_getUses(instr, u);
+        for (k = 0; k < nd->nUses; ++k)
+        {
+            nd->uses[k] = u[k];
+            nd->useVal[k] = lastDef[u[k]] >= 0 ? lastDef[u[k]] : -1 - u[k];
+            schedEdge(adj, n, nodes, lastDef[u[k]], i);          /* RAW */
+            rangeUses[u[k]]++;
+        }
+        nd->def = HC_getDef(instr);
+        if (HC_getOpcodeTypeOp(op) == HCOP_TYPE_MEMOP)
+        {
+            nd->memKind = HC_isStoreOp(op) ? 2 : 1;
+            nd->memBase = HC_getOpcodeSrc0(instr);
+            nd->memImm = HC_opcodeHasImm(instr) ? HC_getOpcodeImm(instr) : -1;
+        }
+        if (nd->def >= 0)
+        {
+            int r = nd->def;
+            /* WAW */
+            schedEdge(adj, n, nodes, lastDef[r], i);
+            /* WAR: every earlier reader of the previous value */
+            for (j = 0; j < i; ++j)
+            {
+                for (k = 0; k < nodes[j].nUses; ++k)
+                {
+                    if (nodes[j].uses[k] == r)
+                        schedEdge(adj, n, nodes, j, i);
+                }
+            }
+            lastDef[r] = i;
+        }
+        /* memory ordering */
+        if (nd->memKind != 0)
+        {
+            for (j = 0; j < i; ++j)
+            {
+                if (schedMemConflict(&nodes[j], nd))
+                    schedEdge(adj, n, nodes, j, i);
+            }
+        }
+    }
+
+    /* live-out values: the last definition of a register that is used
+     * outside the range, used before its first definition in the range
+     * (loop carried) or is a hard register. */
+    for (i = 0; i < n; ++i)
+    {
+        int r = nodes[i].def;
+        if (r < 0 || lastDef[r] != i)
+            continue;
+        if (r < nHardRegs || totalUses[r] > rangeUses[r])
+            nodes[i].defLiveOut = 1;
+    }
+    for (i = 0; i < n; ++i)
+    {
+        for (k = 0; k < nodes[i].nUses; ++k)
+        {
+            if (nodes[i].useVal[k] < 0)
+            {
+                int r = nodes[i].uses[k];
+                if (lastDef[r] >= 0)
+                    nodes[lastDef[r]].defLiveOut = 1;     /* loop carried */
+                else if (r < nHardRegs || totalUses[r] > rangeUses[r])
+                    alwaysLive[r] = 1;                     /* live through */
+            }
+        }
+    }
+    for (i = 0; i < n; ++i)
+    {
+        if (nodes[i].defLiveOut)
+            liveVal[i] = 1;
+        nodes[i].bornAt = nodes[i].defLiveOut ? 0 : -1;
+    }
+
+    /* bottom-up list scheduling */
+    for (step = n - 1; step >= 0; --step)
+    {
+        int best = -1;
+        int bestDelta = 0;
+        int bestBorn = 0;
+
+        for (i = 0; i < n; ++i)
+        {
+            int delta, born;
+            if (scheduled[i] || nodes[i].nSucc != 0)
+                continue;
+            delta = 0;
+            if (nodes[i].def >= 0 && liveVal[i])
+                delta -= 1;
+            for (k = 0; k < nodes[i].nUses; ++k)
+            {
+                int v = nodes[i].useVal[k];
+                if (v < 0 && alwaysLive[-1 - v])
+                    continue;
+                if (!schedValueLive(liveVal, liveIn, v))
+                    delta += 1;
+            }
+            born = nodes[i].bornAt;
+            if (best < 0 || delta < bestDelta
+                || (delta == bestDelta && born > bestBorn)
+                || (delta == bestDelta && born == bestBorn && i > best))
+            {
+                best = i;
+                bestDelta = delta;
+                bestBorn = born;
+            }
+        }
+        if (best < 0)
+        {
+            /* cannot happen for an acyclic graph; keep the original order */
+            HCArena_releaseTop(mgr, topMark);
+            return;
+        }
+        scheduled[best] = 1;
+        order[step] = best;
+        if (nodes[best].def >= 0)
+            liveVal[best] = 0;
+        for (k = 0; k < nodes[best].nUses; ++k)
+        {
+            int v = nodes[best].useVal[k];
+            if (v >= 0)
+            {
+                if (!liveVal[v])
+                {
+                    liveVal[v] = 1;
+                    nodes[v].bornAt = n - step;
+                }
+            }
+            else
+                liveIn[-1 - v] = 1;
+        }
+        for (j = 0; j < n; ++j)
+        {
+            if (ADJ_TEST(adj, n, j, best))
+                nodes[j].nSucc--;
+        }
+    }
+
+    for (i = 0; i < n; ++i)
+        copy[i] = lst[start + order[i]];
+    memcpy(&lst[start], copy, (size_t)n * sizeof(HCInstr_s));
+    HCArena_releaseTop(mgr, topMark);
+}
+
+void HC_pressureSchedule(HCArena_s *mgr, HCInstr_s *lst, int nHardRegs)
+{
+    int topMark = HCArena_markTop(mgr);
+    int numRegs = nHardRegs;
+    int count = 0;
+    unsigned short *totalUses;
+    int i, k;
+
+    while (HC_getOpcodeOper(&lst[count]) != HCOP_EOP)
+    {
+        int u[4];
+        int nUses = HC_getUses(&lst[count], u);
+        int def = HC_getDef(&lst[count]);
+        for (k = 0; k < nUses; ++k)
+            if (u[k] + 1 > numRegs)
+                numRegs = u[k] + 1;
+        if (def + 1 > numRegs)
+            numRegs = def + 1;
+        ++count;
+    }
+    totalUses = (unsigned short *)HCArena_allocTop(mgr, (unsigned int)(numRegs * sizeof(unsigned short)));
+    memset(totalUses, 0, (size_t)numRegs * sizeof(unsigned short));
+    for (i = 0; i < count; ++i)
+    {
+        int u[4];
+        int nUses = HC_getUses(&lst[i], u);
+        for (k = 0; k < nUses; ++k)
+            totalUses[u[k]]++;
+    }
+
+    i = 0;
+    while (i < count)
+    {
+        int s;
+        while (i < count && !schedIsPlain(&lst[i]))
+            ++i;
+        s = i;
+        while (i < count && schedIsPlain(&lst[i]))
+            ++i;
+        if (i > s)
+            scheduleRange(mgr, lst, s, i, totalUses, numRegs, nHardRegs);
+    }
+    HCArena_releaseTop(mgr, topMark);
+}
+
+/* --- local common subexpression elimination ---------------------------------
+ * Per basic block value table of pure ALU expressions. A recomputation is
+ * replaced by a register copy, which copy propagation / dead code
+ * elimination then remove (the bytecode e.g. recomputes fogColor * fog for
+ * every colour channel). Returns the number of replaced instructions. */
+
+#define CSE_MAX 64
+
+typedef struct CseEntry_s
+{
+    int op, a, b, hasImm, dst;
+} CseEntry_s;
+
+static int cseIsPure(HCInstr_s *instr)
+{
+    int op = HC_getOpcodeOper(instr);
+    if (HC_getOpcodeTypeOp(op) != HCOP_TYPE_ALUOP)
+        return 0;
+    if (op == HCOP_MOV || op == HCOP_MOVN || op == HCOP_NOP || op == HCOP_LABEL || op == HCOP_EOP)
+        return 0;
+    if (HC_opcodeDstFlagsOp(op) != HCOP_DST_NORMAL)
+        return 0;
+    return HC_getOpcodeArgCount(instr) == 3;
+}
+
+int HC_localCSE(HCInstr_s *lst)
+{
+    CseEntry_s tab[CSE_MAX];
+    int nTab = 0;
+    int replaced = 0;
+    int pc;
+
+    for (pc = 0; HC_getOpcodeOper(&lst[pc]) != HCOP_EOP; ++pc)
+    {
+        HCInstr_s *instr = &lst[pc];
+        int op = HC_getOpcodeOper(instr);
+        int def, k;
+
+        if (op == HCOP_LABEL || HC_isBranchOp(op) != 0 || op == HCOP_ANSA
+            || (op >= HCOP_FILLB && op <= HCOP_FILLD))
+        {
+            nTab = 0;
+            continue;
+        }
+        def = HC_getDef(instr);
+        if (cseIsPure(instr))
+        {
+            int a = HC_getOpcodeSrc0(instr);
+            int hasImm = HC_opcodeHasImm(instr) != 0;
+            int b = hasImm ? HC_getOpcodeImm(instr) : HC_getOpcodeSrc1(instr);
+            int found = -1;
+
+            if (!hasImm && HC_opcodeIsCommutative(instr) && b < a)
+            {
+                int t = a; a = b; b = t;
+            }
+            for (k = 0; k < nTab; ++k)
+            {
+                if (tab[k].op == op && tab[k].a == a && tab[k].b == b && tab[k].hasImm == hasImm)
+                {
+                    found = tab[k].dst;
+                    break;
+                }
+            }
+            if (found >= 0 && found != def)
+            {
+                *instr = HC_genOp2(HCOP_MOV, def, found);
+                ++replaced;
+            }
+            /* invalidate entries depending on / held in def */
+            for (k = 0; k < nTab; )
+            {
+                if (tab[k].dst == def || tab[k].a == def || (!tab[k].hasImm && tab[k].b == def))
+                    tab[k] = tab[--nTab];
+                else
+                    ++k;
+            }
+            if (found < 0 && def != a && (hasImm || def != b) && nTab < CSE_MAX)
+            {
+                tab[nTab].op = op;
+                tab[nTab].a = a;
+                tab[nTab].b = b;
+                tab[nTab].hasImm = hasImm;
+                tab[nTab].dst = def;
+                ++nTab;
+            }
+            continue;
+        }
+        if (def >= 0)
+        {
+            for (k = 0; k < nTab; )
+            {
+                if (tab[k].dst == def || tab[k].a == def || (!tab[k].hasImm && tab[k].b == def))
+                    tab[k] = tab[--nTab];
+                else
+                    ++k;
+            }
+        }
+    }
+    return replaced;
+}
