+/* hcSchedule.h - HC IR / ARM machine-code schedulers (ARM11 performance work). */
+#ifndef GERBERA_HC_SCHEDULE_H
+#define GERBERA_HC_SCHEDULE_H
+
+#include "gerbera/hc/hcMemory.h"
+#include "gerbera/hc/hcOpcode.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Pre-register-allocation reordering of every basic block's straight-line
+ * code that minimises the number of simultaneously live values. */
+void HC_pressureSchedule(HCArena_s *mgr, HCInstr_s *lst, int nHardRegs);
+
+/* Local (basic block) common subexpression elimination of pure ALU ops. */
+int HC_localCSE(HCInstr_s *lst);
+
+#ifdef __cplusplus
+}
+#endif
+
+/* Debug switch for measurements (bits: 1 pressure schedule, 2 local CSE,
+ * 4 machine peepholes, 8 ARM11 scheduler, 16 USAT hints, 32 renaming,
+ * 64 frame load forwarding). Symbian DLLs have no writable static data, so
+ * there it is a constant 0. */
+#if defined(__SYMBIAN32__)
+#define HC_sched_disable 0u
+#else
+extern unsigned int HC_sched_disable;
+#endif
+
+#endif
diff --git a/tests/arm_jit_bench.py b/tests/arm_jit_bench.py
new file mode 100644
index 0000000..f0ce22d
--- /dev/null
+++ b/tests/arm_jit_bench.py
@@ -0,0 +1,409 @@
+#!/usr/bin/env python3
+"""ARM JIT span benchmark / analyzer for Gerbera pixel pipelines (ARM11 focus).
+
+Extends tests/arm_jit_harness.py with:
+  * realistic spans (N scanlines x L pixels, 64x64 texture, in-range gradients),
+    verified bit-exactly against the host C reference (differential_raster_run);
+  * per-pixel dynamic instruction counts and an ARM1136JF-S cycle estimate
+    (in-order single issue, load-use / multiply / early-shift interlocks);
+  * HC IR dumps (optimized pre-regalloc and post-regalloc) and annotated
+    disassembly of the inner loop.
+
+Usage:
+  .venv/bin/python tests/arm_jit_bench.py [--filter NAME] [--disasm] [--ir pre|post]
+                                         [--len 32] [--rows 4] [--json OUT]
+"""
+from __future__ import annotations
+
+import argparse
+import ctypes as C
+import json
+import random
+import struct
+import sys
+from pathlib import Path
+
+import capstone
+import unicorn
+from unicorn import arm_const as ARM
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "tests"))
+
+from arm_jit_harness import (ArmRunner, base_signature, build_cases, compile_arm,  # noqa: E402
+                             load_lib, make_descriptors)
+from differential_raster import buffer, pixel_texture_record, words  # noqa: E402
+
+OPNAMES = ("ADD AND ASD ASR BIC LSD LSL LSR MAXS MAXU MINS MINU MULS MULU MOV MOVN NOP OR "
+           "ROL ROR SUB SUBR XOR LBS LBU LWS LWU LW2S LW2U LD LD4 SB SW SW2 SD SD4 FILLB "
+           "FILLW FILLD ANSA BRA CBA CBEQ CBGES CBGEU CBGTS CBGTU CBLES CBLEU CBLTS CBLTU "
+           "CBNA CBNEQ EOP LABEL").split()
+
+
+# ---- ARM1136JF-S cycle model ---------------------------------------------------
+
+class Arm11Model:
+    """Approximate ARM1136 timing: single issue, in-order, register interlocks.
+
+    result latency: ALU 1, ALU w/ shift-by-reg 2 (2 issue cycles), LDR 3,
+    MUL/MLA 2 issue + 4 latency, SMULxy/SMLAxy 1 issue + 3, UMULL/SMULL 3 issue + 5,
+    media (USAT/UXTB/PKH/UQADD8...) 2. Registers feeding the barrel shifter or
+    an address are needed one cycle early. Taken branches cost 1 extra cycle
+    (predicted); conditional instructions that fail still issue.
+    """
+
+    MEDIA = {"usat", "ssat", "usat16", "ssat16", "uxtb", "uxth", "uxtb16", "sxtb", "sxth",
+             "sxtb16", "uxtab", "uxtah", "uxtab16", "pkhbt", "pkhtb", "uqadd8", "uqsub8",
+             "uhadd8", "uhsub8", "uadd8", "usub8", "qadd8", "sel", "rev", "rev16", "usad8",
+             "usada8", "uqadd16", "uqsub16", "uadd16", "usub16", "uhadd16", "shadd8", "sadd16",
+             "ssub16", "qadd16", "qsub16", "uqasx", "uqsax"}
+
+    def __init__(self):
+        self.md = capstone.Cs(capstone.CS_ARCH_ARM, capstone.CS_MODE_ARM)
+        self.md.detail = True
+        self.cache = {}
+        self.reset()
+
+    def reset(self):
+        self.t = 0
+        self.ready = {}
+        self.cycles_at = {}
+
+    def decode(self, uc, addr):
+        d = self.cache.get(addr)
+        if d is None:
+            ins = next(self.md.disasm(bytes(uc.mem_read(addr, 4)), addr))
+            mn = ins.mnemonic
+            base = mn
+            for suf in ("eq", "ne", "cs", "cc", "hs", "lo", "mi", "pl", "vs", "vc", "hi", "ls",
+                        "ge", "lt", "gt", "le"):
+                if base.endswith(suf) and len(base) > len(suf) + 1 and base not in ("bic", "teq", "cmp", "mls"):
+                    if base[:-len(suf)] in ("mov", "mvn", "add", "sub", "rsb", "and", "orr", "eor",
+                                            "b", "bx", "ldr", "str", "mul", "mla", "cmp", "bic",
+                                            "movs", "ldrb", "strb", "ldrh", "strh", "pop", "push"):
+                        base = base[:-len(suf)]
+                        break
+            if base.endswith("s") and base[:-1] in ("mov", "mvn", "add", "sub", "rsb", "and",
+                                                     "orr", "eor", "bic", "mul", "mla", "lsl",
+                                                     "lsr", "asr"):
+                base = base[:-1]
+            early, normal, late = set(), set(), set()
+            reg_shift = False
+            for op in ins.operands:
+                if op.type == capstone.arm.ARM_OP_MEM:
+                    if op.mem.base:
+                        early.add(op.mem.base)
+                    if op.mem.index:
+                        early.add(op.mem.index)
+                elif op.type == capstone.arm.ARM_OP_REG:
+                    if op.shift.type != 0 and op.shift.type != capstone.arm.ARM_SFT_INVALID:
+                        early.add(op.reg)
+                        if op.shift.type >= capstone.arm.ARM_SFT_ASR_REG:
+                            reg_shift = True
+                            early.add(op.shift.value)
+            rd_, wr_ = ins.regs_access()
+            reads = set(rd_)
+            writes = set(wr_)
+            if base in ("lsl", "lsr", "asr", "ror") and len(ins.operands) == 3 and \
+                    ins.operands[2].type == capstone.arm.ARM_OP_REG:
+                reg_shift = True
+                early.add(ins.operands[1].reg)
+                early.add(ins.operands[2].reg)
+            elif base in ("lsl", "lsr", "asr", "ror") and len(ins.operands) == 3:
+                early.add(ins.operands[1].reg)
+            if base in ("str", "strb", "strh") and ins.operands:
+                late.add(ins.operands[0].reg)
+            if base == "mla" and len(ins.operands) == 4:
+                late.add(ins.operands[3].reg)
+            if base in ("smlabb", "smlabt", "smlatb", "smlatt", "smlad", "smlsd") and len(ins.operands) == 4:
+                late.add(ins.operands[3].reg)
+            for r in early:
+                reads.discard(r)
+            for r in late:
+                reads.discard(r)
+            pc = capstone.arm.ARM_REG_PC
+            issue, lat = 1, 1
+            if reg_shift:
+                issue, lat = 2, 2
+            if base.startswith("ldr") or base == "pop" or base.startswith("ldm"):
+                lat = 3
+                if base in ("pop",) or base.startswith("ldm"):
+                    issue = max(1, (len(ins.operands) + 1) // 2)
+            elif base == "push" or base.startswith("stm"):
+                issue = max(1, (len(ins.operands) + 1) // 2)
+            elif base in ("mul", "mla", "mls"):
+                issue, lat = 2, 4
+            elif base in ("smulbb", "smulbt", "smultb", "smultt", "smlabb", "smlabt", "smlatb",
+                          "smlatt", "smulwb", "smulwt", "smlawb", "smlawt", "smuad", "smlad",
+                          "smusd", "smlsd"):
+                issue, lat = 1, 3
+            elif base in ("umull", "smull", "umlal", "smlal"):
+                issue, lat = 3, 5
+            elif base in self.MEDIA:
+                lat = 2
+            is_branch = base in ("b", "bl", "bx") or (pc in writes)
+            d = (ins, early, reads, late, writes, issue, lat, is_branch, ins.mnemonic != base and base == "b")
+            self.cache[addr] = d
+        return d
+
+    def step(self, uc, addr):
+        ins, early, reads, late, writes, issue, lat, is_branch, _cond = self.decode(uc, addr)
+        t = self.t
+        for r in early:
+            t = max(t, self.ready.get(r, 0) + 1)
+        for r in reads:
+            t = max(t, self.ready.get(r, 0))
+        for r in late:
+            t = max(t, self.ready.get(r, 0) - 1)
+        start = self.t
+        for r in writes:
+            if r not in (capstone.arm.ARM_REG_PC,):
+                self.ready[r] = t + lat
+        self.t = t + issue
+        self.cycles_at[addr] = self.cycles_at.get(addr, 0) + (self.t - start)
+
+    def branch_taken(self):
+        self.t += 1
+
+
+class BenchRunner(ArmRunner):
+    def __init__(self, model):
+        super().__init__()
+        self.model = model
+        self.counts = {}
+        self.uc.hook_del(self._ic_hook)
+        self._ic_hook = self.uc.hook_add(unicorn.UC_HOOK_CODE, self._hook)
+        self.prev = None
+
+    def _hook(self, uc, address, size, user_data):
+        self.dynamic_insns += 1
+        self.counts[address] = self.counts.get(address, 0) + 1
+        if self.prev is not None and address != self.prev + 4:
+            self.model.branch_taken()
+        self.prev = address
+        self.model.step(uc, address)
+
+    def install_code(self, code):
+        self.model.cache.clear()
+        return super().install_code(code)
+
+    def reset(self):
+        super().reset()
+        self.counts = {}
+        self.model.reset()
+        self.prev = None
+
+
+# ---- scenario ----------------------------------------------------------------
+
+TEX_LOG2 = 6
+
+
+def make_texture(seed, alpha_mode):
+    rnd = random.Random(seed)
+    n = 1 << (2 * TEX_LOG2)
+    px = []
+    for i in range(n):
+        a = 0xFF if alpha_mode == 0 else rnd.choice((0, 0x40, 0x80, 0xC0, 0xFF, rnd.randrange(256)))
+        px.append((a << 24) | rnd.randrange(1 << 24))
+    return px
+
+
+def scenario(case, length, rows):
+    sig = case["sig"]
+    rnd = random.Random(1234)
+    # gradients: z, fog, r, g, b, a, s0, t0, s1, t1 (16.16 colors, 0.32 texcoords)
+    ref = [0x20000000, 40 << 16, 200 << 16, 30 << 16, 120 << 16, 250 << 16, 0x01230000, 0x04560000, 0x00100000, 0x02000000]
+    xadd = [0x00100000, (150 << 16) // max(length, 1), -(170 << 16) // max(length, 1), (200 << 16) // max(length, 1),
+            (100 << 16) // max(length, 1), -(200 << 16) // max(length, 1), 0x04000000 + 0x123, 0x00400000 + 7, 0x05000000, 0x00200000]
+    yadd = [0x00080000, 3 << 16, 2 << 16, 1 << 16, -(1 << 16), 0, 0x00200000, 0x04000000, 0x00300000, 0x03000000]
+    grads = ref + xadd + yadd
+    inputs = case["inputs"]
+    if inputs is None:
+        inputs = [0] * 15
+    inputs = list(inputs)
+    inputs[10] = 0x00305080 if sig[41] == 0 else 0x00A0A0A0  # fog color
+    spans = []
+    for y in range(rows):
+        x0 = (y * 3) % 5
+        spans.append(((length - (y % 3)) << 16) | x0)
+    width = length + 8
+    sampling = []
+    for unit in range(2):
+        rec = sig[56 + 44 * unit:100 + 44 * unit]
+        sh = (32 - TEX_LOG2) if rec[21] == 0 else (20 - TEX_LOG2 + 1)
+        sampling += [(1 << TEX_LOG2) - 1, (1 << TEX_LOG2) - 1, 32 - TEX_LOG2, 32 - TEX_LOG2, TEX_LOG2, rec[19]]
+    return grads, inputs, spans, width, sampling
+
+
+def run_case(lib, runner, case, code, length, rows, check=True):
+    sig = case["sig"]
+    grads, inputs, spans, width, sampling = scenario(case, length, rows)
+    bpp = sig[8] if sig[8] else 4
+    cstride = width * bpp
+    dstride = width * 2
+    sstride = width
+    rnd = random.Random(99)
+    color0 = bytes(rnd.randrange(256) for _ in range(cstride * rows))
+    depth0 = struct.pack("<%dH" % (width * rows), *[rnd.choice((0x1000, 0xFFFF, 0x8000)) for _ in range(width * rows)])
+    sten0 = bytes(rnd.randrange(4) for _ in range(sstride * rows))
+    tex0 = make_texture(5, 1)
+    tex1 = make_texture(6, 1)
+
+    ok = None
+    if check:
+        cbuf, dbuf, sbuf = buffer(color0), buffer(depth0), buffer(sten0)
+        span_arr = (C.c_uint32 * len(spans))(*spans)
+        strides = (C.c_int * 3)(cstride, dstride, sstride)
+        t0 = (C.c_uint32 * len(tex0))(*tex0)
+        t1 = (C.c_uint32 * len(tex1))(*tex1)
+        lib.differential_raster_run(buffer(sig), buffer(words(grads)), cbuf, dbuf, sbuf,
+                                    buffer(words(inputs)), buffer(words(sampling)),
+                                    span_arr, len(spans), strides, t0, t1)
+        ref = (bytes(cbuf), bytes(dbuf), bytes(sbuf))
+
+    runner.reset()
+    bufs = [runner.alloc(len(d), d) for d in (color0, depth0, sten0)]
+    stack = runner.alloc(16384)
+    pipe = stack + 64
+    span_ptr = runner.alloc(4 * len(spans), words(spans))
+    texaddr = [runner.alloc(4 * len(tex0), words(tex0)), runner.alloc(4 * len(tex1), words(tex1))]
+    for unit in range(2):
+        rec = sig[56 + 44 * unit:100 + 44 * unit]
+        if not rec[16]:
+            continue
+        env_color = inputs[8 + unit]
+        s_mask, t_mask, sh_s, sh_t, width_log, linear = sampling[6 * unit:6 * unit + 6]
+        runner.write(pipe + 64 * unit, words([env_color, texaddr[unit], 0, linear,
+                                             s_mask, t_mask, sh_s, sh_t, width_log]))
+    fog_color = inputs[10]
+    if sig[41]:
+        fog_color &= 255
+    runner.write(pipe + 132, words([cstride, dstride, sstride, fog_color, 64, 3, 3, 255, 255]))
+    runner.write(pipe + 168, words([*bufs, len(spans), span_ptr, 0]))
+    runner.write(pipe + 192, words(grads))
+    entry = runner.install_code(code)
+    runner.call(entry, [stack], budget=50_000_000)
+    got = tuple(runner.read(a, len(d)) for a, d in zip(bufs, (color0, depth0, sten0)))
+    if check:
+        ok = got == ref
+    npix = sum(s >> 16 for s in spans)
+    return ok, runner.dynamic_insns, runner.model.t, npix, dict(runner.counts), dict(runner.model.cycles_at)
+
+
+def extra_cases(descriptors):
+    """Further configurations used by the Symbian builds (RGB565/XRGB targets)."""
+    cases = []
+    texels0 = [0xFF204060, 0xFF80A0C0, 0xFF10D070, 0xFFF03090]
+    texels1 = [0xFF8001FE, 0x0100FF7F, 0x7FFE8001, 0x80017FFF]
+    env = [0xFFFFFFFF, 0x80808080]
+
+    def tex_inputs(mode0=3, mode1=3, fog=0, fmt0=2, fmt1=2):
+        return texels0 + texels1 + env + [fog] + [fmt0, fmt1] + [mode0, mode1]
+
+    def add(name, sig, inputs=None):
+        cases.append({"name": name, "sig": bytes(sig), "inputs": inputs, "gradients": None,
+                      "sampling": None, "initial": None})
+
+    for cf, cfn in ((2, "rgba"),):
+        sig = base_signature(descriptors, cf)
+        sig[56:100] = pixel_texture_record(descriptors, fmt=2, mode=0)
+        sig[18] = 1; sig[21] = 1; sig[22] = 3
+        add("x_tex_vcolor_depth_" + cfn, sig, tex_inputs(mode0=0))
+        sig = base_signature(descriptors, cf)
+        sig[56:100] = pixel_texture_record(descriptors, fmt=2, mode=3)
+        sig[18] = 1; sig[21] = 1; sig[22] = 3
+        add("x_tex_replace_depth_" + cfn, sig, tex_inputs(mode0=3))
+        sig = base_signature(descriptors, cf)
+        sig[56:100] = pixel_texture_record(descriptors, fmt=2, mode=0)
+        sig[19] = 1; sig[20] = 4
+        add("x_tex_vcolor_alphatest_" + cfn, sig, tex_inputs(mode0=0))
+    return cases
+
+
+def dump_ir(lib, sig, post):
+    prog = buffer(bytes(32768))
+    count = lib.grExecuteProgram(prog, buffer(sig), 4096)
+    out = buffer(bytes(16384 * 8))
+    lib.differential_raster_compile_ir.argtypes = [C.c_void_p, C.c_uint32, C.c_void_p, C.c_int, C.c_int]
+    n = lib.differential_raster_compile_ir(buffer(bytes(prog)), 0x3FF, out, len(out), 1 if post else 0)
+    raw = bytes(out)
+    lines = []
+    for i in range(max(n, 0)):
+        i0, i1 = struct.unpack_from("<II", raw, 8 * i)
+        op = i0 & 0xFF
+        has_imm = (i0 >> 8) & 1
+        dst = (i0 >> 10) & 0x7FF
+        src0 = (i0 >> 21) & 0x7FF
+        name = OPNAMES[op] if op < len(OPNAMES) else "op%d" % op
+        if name == "LABEL":
+            lines.append("L%d:" % dst)
+            continue
+        s1 = ("#%d" % struct.unpack("<i", struct.pack("<I", i1))[0]) if has_imm else ("r%d" % (i1 & 0x7FF))
+        lines.append("  %-6s r%d, r%d, %s" % (name, dst, src0, s1))
+    return count, lines
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lib", default=str(ROOT / "build/differential/libgerbera_diff.so"))
+    ap.add_argument("--filter", default="")
+    ap.add_argument("--disasm", action="store_true")
+    ap.add_argument("--ir", choices=("pre", "post"))
+    ap.add_argument("--len", type=int, default=32)
+    ap.add_argument("--rows", type=int, default=4)
+    ap.add_argument("--json")
+    ap.add_argument("--disable", type=lambda v: int(v, 0), default=0,
+                    help="HC_sched_disable bits: 1 pressure schedule, 2 local CSE, 4 ARM peepholes, "
+                         "8 ARM11 scheduler, 16 USAT hints, 32 renaming, 64 frame load forwarding")
+    args = ap.parse_args()
+
+    lib = load_lib(Path(args.lib))
+    C.c_uint.in_dll(lib, "HC_sched_disable").value = args.disable
+    lib.differential_raster_run.argtypes = [C.c_void_p] * 7 + [C.c_void_p, C.c_int, C.c_void_p, C.c_void_p, C.c_void_p]
+    lib.differential_raster_run.restype = None
+    descriptors = make_descriptors(lib)
+    cases = build_cases(descriptors) + extra_cases(descriptors)
+    if args.filter:
+        cases = [c for c in cases if any(f in c["name"] for f in args.filter.split(","))]
+    model = Arm11Model()
+    runner = BenchRunner(model)
+    results = {}
+    print("%-36s %6s %6s %8s %8s %7s %7s %5s" % ("case", "bytes", "insns", "dyn", "cycles", "ins/px", "cyc/px", "ok"))
+    fails = 0
+    for case in cases:
+        hc, code, mask, length = compile_arm(lib, case["sig"])
+        if code is None:
+            print("%-36s COMPILE FAIL %s" % (case["name"], length))
+            fails += 1
+            continue
+        ok, dyn, cyc, npix, counts, cyc_at = run_case(lib, runner, case, code, args.len, args.rows)
+        # per-pixel marginal cost: difference between two lengths removes span overhead
+        ok2, dyn2, cyc2, npix2, _, _ = run_case(lib, runner, case, code, args.len * 2, args.rows)
+        ipx = (dyn2 - dyn) / (npix2 - npix)
+        cpx = (cyc2 - cyc) / (npix2 - npix)
+        good = ok and ok2
+        fails += 0 if good else 1
+        results[case["name"]] = {"bytes": len(code), "dyn": dyn, "cycles": cyc, "npix": npix,
+                                 "ins_px": ipx, "cyc_px": cpx, "ok": good}
+        print("%-36s %6d %6d %8d %8d %7.2f %7.2f %5s" % (case["name"], len(code), len(code) // 4, dyn, cyc,
+                                                        ipx, cpx, "ok" if good else "FAIL"))
+        if args.ir:
+            n, lines = dump_ir(lib, case["sig"], args.ir == "post")
+            print("\n".join(lines))
+        if args.disasm:
+            md = capstone.Cs(capstone.CS_ARCH_ARM, capstone.CS_MODE_ARM)
+            base = runner.CODE
+            for ins in md.disasm(code, base):
+                n = counts.get(ins.address, 0)
+                c = cyc_at.get(ins.address, 0)
+                print("  %6d %6d  %04x: %-8s %s" % (n, c, ins.address - base, ins.mnemonic, ins.op_str))
+            print()
+    print("%d/%d ok" % (len(cases) - fails, len(cases)))
+    if args.json:
+        Path(args.json).write_text(json.dumps(results, indent=1))
+    return 1 if fails else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
