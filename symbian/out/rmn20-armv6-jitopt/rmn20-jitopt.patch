+/* IR inspection helpers (JIT perf work): optimized HC IR without a backend,
+ * and the post-regalloc IR the ARM backend consumes (via emuDst). */
+int differential_raster_compile_ir(void *instructions, unsigned int optimizationMask,
+                                   void *out, int capacity, int postRegalloc)
+{
+    static union { uint64_t alignment; unsigned char bytes[1024 * 1024]; } arena;
+    static HCInstr_s emu[16384];
+    HCSetjmpConfig_s config;
+    void *output = NULL;
+    unsigned char mask[16];
+    int length, n = 0;
+    config.setjmpWrap = raster_compile_wrap;
+    config.longjmp = raster_compile_jump;
+    config.jmpbufSize = (unsigned int)((sizeof(jmp_buf) + 15u) & ~15u);
+    memset(emu, 0, sizeof(emu));
+    length = HC_compilePriv(arena.bytes, sizeof(arena.bytes), &config, &output,
+                            postRegalloc ? emu : NULL, (HCInstr_s *)instructions,
+                            postRegalloc ? HCARMBackend_create() : NULL, optimizationMask,
+                            mask, (unsigned char *)g_mutableParamsMask, 78);
+    if (length < 0)
+        return length;
+    {
+        const HCInstr_s *src = postRegalloc ? emu : (const HCInstr_s *)output;
+        while (n < 16384 && (src[n].instr0 & 0xFF) != 53)
+            ++n;
+        ++n;
+        if ((int)(n * sizeof(HCInstr_s)) > capacity)
+            return -2;
+        memcpy(out, src, n * sizeof(HCInstr_s));
+    }
+    return n;
+}
