@@ -0,0 +1,1115 @@
+/* hcARMSched.c - machine-code level optimisation of HC ARM backend output
+ * for the ARM1136JF-S (ARM11, ARMv6) pipeline.
+ *
+ * Not part of the original Gerbera compiler (ARM11 performance work).
+ *
+ * Runs on the emitted A32 words of one compiled pixel pipeline, before the
+ * branch displacements are patched (branch words still hold label ids):
+ *
+ *  1. decode every word into register reads (normal / early / late),
+ *     writes, flag use, memory access and ARM11 issue/latency figures;
+ *  2. split basic blocks at labels and branches and compute register
+ *     liveness over the control-flow graph;
+ *  3. ARMv6 peepholes that need liveness:
+ *       LSR t,s,#8|16|24 ; AND d,t,#255      -> UXTB d,s,ROR #n
+ *       LSR t,s,#k ; USAT d,#n,t (s < 2^31)  -> USAT d,#n,s,ASR #k
+ *       ALU x,... ; CMP x,#0 ; B{EQ,NE,MI,PL} -> ALUS x,... ; B..
+ *  4. list scheduling of every block for the ARM11 interlocks (3-cycle
+ *     loads, 4-cycle MUL/MLA, operands needed early by the barrel shifter
+ *     and the address generator), keeping every register, flag and memory
+ *     dependence;
+ *  5. compaction of removed words and remapping of the label offsets.
+ */
+#include "gerbera/hc/hcARMSched.h"
+
+#include <string.h>
+
+#define AS_NOP 0xE1A00000u /* MOV r0, r0 - removal marker (never emitted otherwise) */
+
+enum { ARMK_ALU = 0, ARMK_LOAD, ARMK_STORE, ARMK_BRANCH, ARMK_BARRIER };
+
+/* register field layouts (for renaming) */
+enum { ARMF_NONE = 0, ARMF_DP, ARMF_MUL, ARMF_MEDIA, ARMF_MEM };
+
+typedef struct ArmIns_s
+{
+    unsigned int w;
+    unsigned short rd;      /* normal reads */
+    unsigned short early;   /* reads needed one cycle early (shifter / address) */
+    unsigned short late;    /* reads needed one cycle late (store data / accumulator) */
+    unsigned short def;     /* written registers */
+    unsigned char rflags, wflags, kind, issue, lat, cond;
+    unsigned char fmt;      /* register field layout, see F_* */
+    signed char memBase;
+    int memImm;             /* >= 0 immediate offset, -1 register / writeback */
+} ArmIns_s;
+
+static void armDecode(ArmIns_s *d, unsigned int w)
+{
+    unsigned int cond = w >> 28;
+    unsigned int rn = (w >> 16) & 15u, rdd = (w >> 12) & 15u, rs = (w >> 8) & 15u, rm = w & 15u;
+
+    memset(d, 0, sizeof(*d));
+    d->w = w;
+    d->cond = (unsigned char)cond;
+    d->issue = 1;
+    d->lat = 1;
+    d->memBase = -1;
+    d->memImm = -1;
+    d->kind = ARMK_ALU;
+
+    if (cond == 15u)
+    {
+        d->kind = ARMK_BARRIER;
+        return;
+    }
+    if ((w & 0x0E000000u) == 0x0A000000u)            /* B / BL */
+    {
+        d->kind = ARMK_BRANCH;
+        if (cond != 14u)
+            d->rflags = 1;
+        return;
+    }
+    if ((w & 0x0E000000u) == 0x08000000u)            /* LDM / STM */
+    {
+        d->kind = ARMK_BARRIER;
+        return;
+    }
+    if ((w & 0x0FC000F0u) == 0x00000090u)            /* MUL / MLA */
+    {
+        d->fmt = ARMF_MUL;
+        d->def = (unsigned short)(1u << rn);
+        d->rd = (unsigned short)((1u << rm) | (1u << rs));
+        if (w & 0x00200000u)
+            d->late = (unsigned short)(1u << rdd);
+        if (w & 0x00100000u)
+            d->wflags = 1;
+        d->issue = 2;
+        d->lat = 4;
+    }
+    else if ((w & 0x0FF00090u) == 0x01000080u)       /* SMLAxy */
+    {
+        d->fmt = ARMF_MUL;
+        d->def = (unsigned short)(1u << rn);
+        d->rd = (unsigned short)((1u << rm) | (1u << rs));
+        d->late = (unsigned short)(1u << rdd);
+        d->lat = 3;
+    }
+    else if ((w & 0x0FF00090u) == 0x01600080u)       /* SMULxy */
+    {
+        d->fmt = ARMF_MUL;
+        d->def = (unsigned short)(1u << rn);
+        d->rd = (unsigned short)((1u << rm) | (1u << rs));
+        d->lat = 3;
+    }
+    else if ((w & 0x0FA00030u) == 0x06A00010u)       /* SSAT / USAT */
+    {
+        d->fmt = ARMF_MEDIA;
+        d->def = (unsigned short)(1u << rdd);
+        if ((w & 0x00000FC0u) != 0)
+            d->early = (unsigned short)(1u << rm);
+        else
+            d->rd = (unsigned short)(1u << rm);
+        d->lat = 2;
+    }
+    else if ((w & 0x0F8000F0u) == 0x06800070u)       /* xXTx / xXTAx */
+    {
+        d->fmt = ARMF_MEDIA;
+        d->def = (unsigned short)(1u << rdd);
+        if ((w & 0x00000C00u) != 0)
+            d->early = (unsigned short)(1u << rm);
+        else
+            d->rd = (unsigned short)(1u << rm);
+        if (rn != 15u)
+            d->rd |= (unsigned short)(1u << rn);
+        d->lat = 1;
+    }
+    else if ((w & 0x0E000090u) == 0x00000090u && (w & 0x60u) != 0)  /* LDRH/STRH/LDRSB/LDRSH */
+    {
+        int load = (w & 0x00100000u) != 0;
+        int wb = (w & 0x00200000u) != 0 || (w & 0x01000000u) == 0;
+        d->fmt = (unsigned char)(wb ? ARMF_NONE : ARMF_MEM);
+        d->kind = load ? ARMK_LOAD : ARMK_STORE;
+        d->early = (unsigned short)(1u << rn);
+        if ((w & 0x00400000u) == 0)
+            d->early |= (unsigned short)(1u << rm);
+        else if (!wb)
+            d->memImm = (int)(((w >> 4) & 0xF0u) | (w & 0xFu)) * ((w & 0x00800000u) ? 1 : -1) + 0x10000;
+        d->memBase = (signed char)rn;
+        if (load)
+        {
+            d->def = (unsigned short)(1u << rdd);
+            d->lat = 3;
+        }
+        else
+            d->late = (unsigned short)(1u << rdd);
+        if (wb)
+            d->def |= (unsigned short)(1u << rn);
+        if (rdd == 15u)
+            d->kind = ARMK_BARRIER;
+    }
+    else if ((w & 0x0C000000u) == 0x04000000u)       /* LDR / STR / LDRB / STRB */
+    {
+        int load = (w & 0x00100000u) != 0;
+        int wb = (w & 0x00200000u) != 0 || (w & 0x01000000u) == 0;
+        if ((w & 0x02000000u) != 0 && (w & 0x10u) != 0)
+        {
+            d->kind = ARMK_BARRIER;                     /* media space, unknown */
+            return;
+        }
+        d->fmt = (unsigned char)(wb ? ARMF_NONE : ARMF_MEM);
+        d->kind = load ? ARMK_LOAD : ARMK_STORE;
+        d->early = (unsigned short)(1u << rn);
+        if ((w & 0x02000000u) != 0)
+            d->early |= (unsigned short)(1u << rm);
+        else if (!wb)
+            d->memImm = (int)(w & 0xFFFu) * ((w & 0x00800000u) ? 1 : -1) + 0x10000;
+        d->memBase = (signed char)rn;
+        if (load)
+        {
+            d->def = (unsigned short)(1u << rdd);
+            d->lat = 3;
+        }
+        else
+            d->late = (unsigned short)(1u << rdd);
+        if (wb)
+            d->def |= (unsigned short)(1u << rn);
+        if (rdd == 15u || rn == 15u)
+            d->kind = ARMK_BARRIER;
+    }
+    else if ((w & 0x0C000000u) == 0x00000000u
+             && !((w & 0x01900000u) == 0x01000000u))  /* data processing */
+    {
+        unsigned int op = (w >> 21) & 15u;
+        int setS = (w & 0x00100000u) != 0;
+        d->fmt = ARMF_DP;
+        if (w & 0x02000000u)
+        {
+            /* immediate operand */
+        }
+        else if (w & 0x10u)
+        {
+            if (w & 0x80u)
+            {
+                d->kind = ARMK_BARRIER;                 /* other extension space */
+                return;
+            }
+            d->early = (unsigned short)((1u << rm) | (1u << rs));
+            d->issue = 2;
+            d->lat = 2;
+        }
+        else
+        {
+            unsigned int amt = (w >> 7) & 31u, st = (w >> 5) & 3u;
+            if (amt == 0 && st == 3u)
+                d->rflags = 1;                       /* RRX */
+            if (amt != 0 || st != 0)
+                d->early = (unsigned short)(1u << rm);
+            else
+                d->rd = (unsigned short)(1u << rm);
+        }
+        if (op != 13u && op != 15u)
+            d->rd |= (unsigned short)(1u << rn);
+        if (op >= 8u && op <= 11u)
+            d->wflags = 1;
+        else
+            d->def = (unsigned short)(1u << rdd);
+        if (setS)
+            d->wflags = 1;
+        if (op == 5u || op == 6u || op == 7u)
+            d->rflags = 1;
+        if ((d->def & 0x8000u) != 0 || rn == 15u || ((d->rd | d->early) & 0x8000u) != 0)
+            d->kind = ARMK_BARRIER;
+    }
+    else
+    {
+        d->kind = ARMK_BARRIER;
+        return;
+    }
+
+    if (cond != 14u)
+    {
+        d->rflags = 1;
+        d->rd |= d->def;                             /* conditional write keeps the old value */
+    }
+    if ((d->def & 1u) != 0 && d->kind != ARMK_BARRIER)
+        d->kind = ARMK_BARRIER;                         /* r0 is the frame pointer */
+}
+
+static unsigned short insReads(const ArmIns_s *d)
+{
+    return (unsigned short)(d->rd | d->early | d->late);
+}
+
+/* --- blocks and liveness ------------------------------------------------- */
+
+typedef struct ArmBlock_s
+{
+    int start, end;          /* [start, end) */
+    int succ[2];
+    unsigned short use, def, liveIn, liveOut;
+} ArmBlock_s;
+
+static int labelTarget(const int *labelIds, const int *labelOffsets, int nLabels, int id)
+{
+    int i;
+    for (i = 0; i < nLabels; ++i)
+        if (labelIds[i] == id)
+            return labelOffsets[i];
+    return -1;
+}
+
+static int findBlock(const ArmBlock_s *blocks, int nBlocks, int offset)
+{
+    int b;
+    for (b = 0; b < nBlocks; ++b)
+        if (blocks[b].start == offset || (blocks[b].start <= offset && offset < blocks[b].end))
+            return b;
+    return -1;
+}
+
+/* --- list scheduler ------------------------------------------------------ */
+
+#define SCHED_MAX 128
+
+static int memConflict(const ArmIns_s *a, const ArmIns_s *b)
+{
+    if (a->kind != ARMK_LOAD && a->kind != ARMK_STORE)
+        return 0;
+    if (b->kind != ARMK_LOAD && b->kind != ARMK_STORE)
+        return 0;
+    if (a->kind == ARMK_LOAD && b->kind == ARMK_LOAD)
+        return 0;
+    /* r0 frame slots never alias the colour / depth / stencil / texture
+     * memory reached through other base registers. */
+    if ((a->memBase == 0) != (b->memBase == 0))
+        return 0;
+    if (a->memBase == 0 && a->memImm >= 0 && b->memImm >= 0)
+        return a->memImm == b->memImm;
+    return 1;
+}
+
+static int depLatency(const ArmIns_s *p, const ArmIns_s *s)
+{
+    int lat = 1;
+    unsigned short raw = p->def;
+    if (raw & s->early)
+        lat = p->lat + 1;
+    else if (raw & s->rd)
+        lat = p->lat;
+    else if (raw & s->late)
+        lat = p->lat > 1 ? p->lat - 1 : 1;
+    if (p->wflags && s->rflags && lat < 1)
+        lat = 1;
+    return lat;
+}
+
+typedef struct SchedWork_s
+{
+    unsigned char adj[SCHED_MAX][SCHED_MAX / 8];
+    int npred[SCHED_MAX], height[SCHED_MAX], ready[SCHED_MAX], order[SCHED_MAX];
+    unsigned char done[SCHED_MAX];
+    ArmIns_s tmp[SCHED_MAX];
+} SchedWork_s;
+
+#define ADJ(i, j) (W->adj[i][(j) >> 3] & (1u << ((j) & 7)))
+
+static void scheduleBlock(SchedWork_s *W, ArmIns_s *ins, int start, int end)
+{
+    int n = end - start;
+    int i, j, cyc, step;
+
+    if (n < 3 || n > SCHED_MAX)
+        return;
+    memset(W->adj, 0, sizeof(W->adj));
+    for (i = 0; i < n; ++i)
+    {
+        W->npred[i] = 0;
+        W->ready[i] = 0;
+        W->done[i] = 0;
+    }
+    for (j = 0; j < n; ++j)
+    {
+        const ArmIns_s *sj = &ins[start + j];
+        for (i = 0; i < j; ++i)
+        {
+            const ArmIns_s *p = &ins[start + i];
+            int dep = 0;
+            if (p->def & insReads(sj)) dep = 1;             /* RAW */
+            if (insReads(p) & sj->def) dep = 1;             /* WAR */
+            if (p->def & sj->def) dep = 1;                  /* WAW */
+            if ((p->wflags && (sj->rflags || sj->wflags)) || (p->rflags && sj->wflags)) dep = 1;
+            if (memConflict(p, sj)) dep = 1;
+            if (p->kind == ARMK_BARRIER || sj->kind == ARMK_BARRIER || sj->kind == ARMK_BRANCH) dep = 1;
+            if (dep)
+            {
+                W->adj[i][j >> 3] |= (unsigned char)(1u << (j & 7));
+                W->npred[j]++;
+            }
+        }
+    }
+    for (i = n - 1; i >= 0; --i)
+    {
+        int h = ins[start + i].issue;
+        for (j = i + 1; j < n; ++j)
+        {
+            if (ADJ(i, j))
+            {
+                int l = depLatency(&ins[start + i], &ins[start + j]);
+                if (l + W->height[j] > h)
+                    h = l + W->height[j];
+            }
+        }
+        W->height[i] = h;
+    }
+    cyc = 0;
+    for (step = 0; step < n; ++step)
+    {
+        int best = -1, bestStart = 0;
+        for (i = 0; i < n; ++i)
+        {
+            int st;
+            if (W->done[i] || W->npred[i] != 0)
+                continue;
+            st = W->ready[i] > cyc ? W->ready[i] : cyc;
+            if (best < 0 || st < bestStart
+                || (st == bestStart && W->height[i] > W->height[best]))
+            {
+                best = i;
+                bestStart = st;
+            }
+        }
+        W->done[best] = 1;
+        W->order[step] = best;
+        cyc = bestStart + ins[start + best].issue;
+        for (j = 0; j < n; ++j)
+        {
+            if (ADJ(best, j))
+            {
+                int r = bestStart + depLatency(&ins[start + best], &ins[start + j]);
+                if (r > W->ready[j])
+                    W->ready[j] = r;
+                W->npred[j]--;
+            }
+        }
+    }
+    for (i = 0; i < n; ++i)
+        W->tmp[i] = ins[start + W->order[i]];
+    memcpy(&ins[start], W->tmp, (size_t)n * sizeof(ArmIns_s));
+}
+
+/* --- peepholes ----------------------------------------------------------- */
+
+static int isPlainAL(const ArmIns_s *d)
+{
+    return d->cond == 14u && d->kind == ARMK_ALU;
+}
+
+/* next reader of register r after index i inside [i+1, end); returns index or
+ * -1, and sets *redef when r (or src) is redefined first. */
+static int deadAfter(const ArmIns_s *ins, int from, int end, unsigned short liveOut, int r)
+{
+    int k;
+    for (k = from; k < end; ++k)
+    {
+        if (insReads(&ins[k]) & (1u << r))
+            return 0;
+        if (ins[k].def & (1u << r))
+            return ins[k].cond == 14u;
+    }
+    return (liveOut & (1u << r)) == 0;
+}
+
+static void peepholeBlock(ArmIns_s *ins, int start, int end, unsigned short liveOut,
+                          const int *usatHints, int nUsatHints, const int *origIndex)
+{
+    int i, k;
+    for (i = start; i < end; ++i)
+    {
+        ArmIns_s *a = &ins[i];
+        unsigned int w = a->w;
+        unsigned int t, s, amt;
+        /* MOV t, s, LSR #amt */
+        if (!isPlainAL(a) || (w & 0x0FEF0070u) != 0x01A00020u)
+            continue;
+        t = (w >> 12) & 15u;
+        s = w & 15u;
+        amt = (w >> 7) & 31u;
+        if (amt == 0)
+            continue;
+        for (k = i + 1; k < end; ++k)
+        {
+            ArmIns_s *b = &ins[k];
+            if (insReads(b) & (1u << t))
+            {
+                unsigned int bw = b->w;
+                if (b->cond != 14u)
+                    break;
+                /* AND d, t, #255 -> UXTB d, s, ROR #amt */
+                if ((bw & 0x0FFF0FFFu) == (0x020000FFu | (t << 16))
+                    && (amt == 8 || amt == 16 || amt == 24)
+                    && (((bw >> 12) & 15u) == t || deadAfter(ins, k + 1, end, liveOut, (int)t)))
+                {
+                    unsigned int d = (bw >> 12) & 15u;
+                    armDecode(b, 0xE6EF0070u | (d << 12) | ((amt / 8u) << 10) | s);
+                    armDecode(a, AS_NOP);
+                }
+                /* USAT d, #n, t (hinted: t = s >> amt with s < 2^31) -> USAT d, #n, s, ASR #amt */
+                else if ((bw & 0x0FE00FF0u) == 0x06E00010u && (bw & 15u) == t
+                         && (((bw >> 12) & 15u) == t || deadAfter(ins, k + 1, end, liveOut, (int)t)))
+                {
+                    int h, hinted = 0;
+                    for (h = 0; h < nUsatHints; ++h)
+                        if (usatHints[h] == origIndex[k])
+                            hinted = 1;
+                    if (hinted)
+                    {
+                        armDecode(b, (bw & 0xFFFFF000u) | (amt << 7) | 0x50u | s);
+                        armDecode(a, AS_NOP);
+                    }
+                }
+                /* MOV d, t, LSL #amt -> BIC d, s, #(2^amt - 1) */
+                else if (amt <= 8u && (bw & 0x0FFF0FFFu) == (0x01A00000u | (amt << 7) | t)
+                         && (((bw >> 12) & 15u) == t || deadAfter(ins, k + 1, end, liveOut, (int)t)))
+                {
+                    unsigned int d = (bw >> 12) & 15u;
+                    armDecode(b, 0xE3C00000u | (s << 16) | (d << 12) | ((1u << amt) - 1u));
+                    armDecode(a, AS_NOP);
+                }
+                break;
+            }
+            if (ins[k].def & ((1u << t) | (1u << s)))
+                break;
+            if (ins[k].kind == ARMK_BARRIER || ins[k].kind == ARMK_BRANCH)
+                break;
+        }
+    }
+
+    /* MUL t, a, b ; ADD d, t, c  ->  MLA d, a, b, c (placed at the ADD when a, b
+     * survive until there, otherwise at the MUL when c and d are untouched) */
+    for (i = start; i < end; ++i)
+    {
+        ArmIns_s *m = &ins[i];
+        unsigned int t, ra, rb;
+        unsigned short defs = 0, reads = 0;
+        if (m->cond != 14u || (m->w & 0x0FF0F0F0u) != 0x00000090u)
+            continue;
+        t = (m->w >> 16) & 15u;
+        ra = m->w & 15u;
+        rb = (m->w >> 8) & 15u;
+        for (k = i + 1; k < end; ++k)
+        {
+            ArmIns_s *b = &ins[k];
+            if (b->w == AS_NOP)
+                continue;
+            if (insReads(b) & (1u << t))
+            {
+                unsigned int bw = b->w, rn = (bw >> 16) & 15u, rm = bw & 15u, c, d;
+                if (b->cond == 14u && (bw & 0x0FF00FF0u) == 0x00800000u && (rn == t) != (rm == t)
+                    && rn != 15u && rm != 15u)
+                {
+                    c = (rn == t) ? rm : rn;
+                    d = (bw >> 12) & 15u;
+                    if (d == t || deadAfter(ins, k + 1, end, liveOut, (int)t))
+                    {
+                        unsigned int mla = 0xE0200090u | (d << 16) | (c << 12) | (rb << 8) | ra;
+                        if (t != ra && t != rb && (defs & ((1u << ra) | (1u << rb))) == 0)
+                        {
+                            armDecode(b, mla);
+                            armDecode(m, AS_NOP);
+                        }
+                        else if (c != t && (defs & (1u << c)) == 0
+                                 && ((defs | reads) & (1u << d)) == 0)
+                        {
+                            armDecode(m, mla);
+                            armDecode(b, AS_NOP);
+                        }
+                    }
+                }
+                break;
+            }
+            defs |= b->def;
+            reads |= insReads(b);
+            if (b->def & (1u << t))
+                break;
+            if (b->kind == ARMK_BARRIER || b->kind == ARMK_BRANCH)
+                break;
+        }
+    }
+
+    /* CMP x, #0 ; B{EQ,NE,MI,PL} -> set S on the last writer of x */
+    if (end - start >= 2)
+    {
+        ArmIns_s *br = &ins[end - 1];
+        ArmIns_s *cmp = &ins[end - 2];
+        if (br->kind == ARMK_BRANCH && (br->cond <= 1u || br->cond == 4u || br->cond == 5u)
+            && (cmp->w & 0x0FF0FFFFu) == 0x03500000u && cmp->cond == 14u)
+        {
+            unsigned int x = (cmp->w >> 16) & 15u;
+            for (k = end - 3; k >= start; --k)
+            {
+                ArmIns_s *p = &ins[k];
+                if (p->w == AS_NOP)
+                    continue;
+                if (p->wflags || p->rflags || p->kind == ARMK_BARRIER)
+                    break;
+                if (p->def & (1u << x))
+                {
+                    unsigned int op = (p->w >> 21) & 15u;
+                    if (isPlainAL(p) && (p->w & 0x0C000000u) == 0 && op != 10u && op != 8u
+                        && op != 9u && op != 11u && (p->w & 0x0FC000F0u) != 0x00000090u
+                        && p->def == (1u << x))
+                    {
+                        armDecode(p, p->w | 0x00100000u);
+                        armDecode(cmp, AS_NOP);
+                    }
+                    break;
+                }
+            }
+        }
+    }
+}
+
+/* --- register renaming ------------------------------------------------------
+ * Post-allocation renaming of block-local live ranges onto registers that
+ * are free over the range, so that reused spill/temporary registers do not
+ * serialise the scheduler (anti and output dependences). */
+
+static unsigned int setField(unsigned int w, int shift, unsigned int from, unsigned int to)
+{
+    if (((w >> shift) & 15u) == from)
+        w = (w & ~(15u << shift)) | (to << shift);
+    return w;
+}
+
+/* rewrite the read operands equal to 'from' */
+static int renameReads(ArmIns_s *d, unsigned int from, unsigned int to)
+{
+    unsigned int w = d->w;
+    switch (d->fmt)
+    {
+    case ARMF_DP:
+    {
+        unsigned int op = (w >> 21) & 15u;
+        if (op != 13u && op != 15u)
+            w = setField(w, 16, from, to);
+        if ((w & 0x02000000u) == 0)
+        {
+            w = setField(w, 0, from, to);
+            if (w & 0x10u)
+                w = setField(w, 8, from, to);
+        }
+        break;
+    }
+    case ARMF_MUL:
+        w = setField(w, 0, from, to);
+        w = setField(w, 8, from, to);
+        if ((w & 0x0FC000F0u) != 0x00000090u || (w & 0x00200000u))
+            if ((w & 0x0FF00090u) != 0x01600080u)
+                w = setField(w, 12, from, to);
+        break;
+    case ARMF_MEDIA:
+        w = setField(w, 0, from, to);
+        if ((w & 0x0F8000F0u) == 0x06800070u && ((w >> 16) & 15u) != 15u)
+            w = setField(w, 16, from, to);
+        break;
+    case ARMF_MEM:
+        w = setField(w, 16, from, to);
+        if (d->kind == ARMK_STORE)
+            w = setField(w, 12, from, to);
+        if ((w & 0x0C000000u) == 0x04000000u ? (w & 0x02000000u) != 0 : (w & 0x00400000u) == 0)
+            w = setField(w, 0, from, to);
+        break;
+    default:
+        return 0;
+    }
+    armDecode(d, w);
+    return 1;
+}
+
+static int renameDef(ArmIns_s *d, unsigned int from, unsigned int to)
+{
+    unsigned int w = d->w;
+    switch (d->fmt)
+    {
+    case ARMF_DP:
+    case ARMF_MEDIA:
+        w = setField(w, 12, from, to);
+        break;
+    case ARMF_MUL:
+        w = setField(w, 16, from, to);
+        break;
+    case ARMF_MEM:
+        if (d->kind != ARMK_LOAD)
+            return 0;
+        w = setField(w, 12, from, to);
+        break;
+    default:
+        return 0;
+    }
+    armDecode(d, w);
+    return 1;
+}
+
+#define RENAMABLE 0x5FFEu  /* r1-r12, lr */
+
+static void renameBlock(ArmIns_s *ins, int start, int end, unsigned short liveOut,
+                        unsigned short *liveAfter)
+{
+    int i, j;
+    unsigned short live = liveOut;
+
+    if (end - start < 2)
+        return;
+    for (i = end - 1; i >= start; --i)
+    {
+        liveAfter[i - start] = live;
+        if (ins[i].cond == 14u)
+            live = (unsigned short)(live & ~ins[i].def);
+        live |= insReads(&ins[i]);
+        if (ins[i].kind == ARMK_BARRIER)
+            live = 0xFFFFu;
+    }
+    for (i = start; i < end; ++i)
+    {
+        ArmIns_s *d = &ins[i];
+        unsigned int t, f;
+        int last = -1, ok = 1, bestF = -1, bestAge = 0;
+        unsigned short busy;
+
+        if (d->cond != 14u || d->kind == ARMK_BARRIER || d->kind == ARMK_BRANCH || d->fmt == ARMF_NONE)
+            continue;
+        if (d->def == 0 || (d->def & (d->def - 1)) != 0 || (d->def & RENAMABLE) == 0)
+            continue;
+        if (d->fmt == ARMF_MEM && d->kind != ARMK_LOAD)
+            continue;
+        t = 0;
+        while (((d->def >> t) & 1u) == 0)
+            ++t;
+        if (insReads(d) & (1u << t))
+            continue;                                /* read-modify-write */
+        /* live range of this definition */
+        busy = (unsigned short)(insReads(d) | d->def);
+        for (j = i + 1; j < end; ++j)
+        {
+            ArmIns_s *u = &ins[j];
+            if (insReads(u) & (1u << t))
+            {
+                if (u->cond != 14u || u->fmt == ARMF_NONE || (u->def & (1u << t)) != 0)
+                {
+                    ok = 0;
+                    break;
+                }
+                last = j;
+            }
+            else if (u->def & (1u << t))
+                break;
+            if (u->kind == ARMK_BARRIER)
+            {
+                ok = 0;
+                break;
+            }
+        }
+        if (!ok || last < 0)
+            continue;
+        if (j >= end && (liveOut & (1u << t)))
+            continue;                                /* live out of the block */
+        if (liveAfter[last - start] & (1u << t))
+            continue;
+        for (j = i; j <= last; ++j)
+        {
+            busy |= liveAfter[j - start];
+            busy |= ins[j].def | insReads(&ins[j]);
+        }
+        /* prefer the register untouched for the longest time before i */
+        for (f = 1; f < 15; ++f)
+        {
+            int age;
+            if (((RENAMABLE >> f) & 1u) == 0 || (busy >> f) & 1u || f == t)
+                continue;
+            for (j = i - 1, age = 0; j >= start; --j, ++age)
+                if ((ins[j].def | insReads(&ins[j])) & (1u << f))
+                    break;
+            if (j < start)
+                age = 1000;
+            if (bestF < 0 || age > bestAge)
+            {
+                bestF = (int)f;
+                bestAge = age;
+            }
+        }
+        {
+            int tAge;
+            for (j = i - 1, tAge = 0; j >= start; --j, ++tAge)
+                if ((ins[j].def | insReads(&ins[j])) & (1u << t))
+                    break;
+            if (j < start)
+                tAge = 1000;
+            if (bestF < 0 || bestAge <= tAge)
+                continue;                            /* t itself is as good */
+        }
+        if (!renameDef(d, t, (unsigned int)bestF))
+            continue;
+        for (j = i + 1; j <= last; ++j)
+            if (insReads(&ins[j]) & (1u << t))
+                renameReads(&ins[j], t, (unsigned int)bestF);
+        /* refresh liveness for the renamed range */
+        for (j = i; j < last; ++j)
+        {
+            liveAfter[j - start] = (unsigned short)((liveAfter[j - start] & ~(1u << t)) | (1u << bestF));
+        }
+    }
+}
+
+/* --- redundant frame load elimination --------------------------------------
+ * A second LDR rX, [r0, #imm] of a frame slot that was already loaded in the
+ * same block (and not stored in between) reuses the first value: either the
+ * first destination still holds it, or both live ranges are merged onto a
+ * register that is free over the whole window. */
+
+static void computeLiveAfter(const ArmIns_s *ins, int start, int end, unsigned short liveOut,
+                             unsigned short *liveAfter)
+{
+    int i;
+    unsigned short live = liveOut;
+    for (i = end - 1; i >= start; --i)
+    {
+        liveAfter[i - start] = live;
+        if (ins[i].cond == 14u)
+            live = (unsigned short)(live & ~ins[i].def);
+        live |= insReads(&ins[i]);
+        if (ins[i].kind == ARMK_BARRIER)
+            live = 0xFFFFu;
+    }
+}
+
+/* last reader of the value defined by ins[i] in register t; -1 if the range
+ * cannot be renamed (unrenamable reader, leaves the block, ...), i if unused */
+static int valueRangeEnd(const ArmIns_s *ins, int i, int end, unsigned short liveOut,
+                         const unsigned short *liveAfter, int start, unsigned int t)
+{
+    int j, last = i;
+    for (j = i + 1; j < end; ++j)
+    {
+        const ArmIns_s *u = &ins[j];
+        if (insReads(u) & (1u << t))
+        {
+            if (u->cond != 14u || u->fmt == ARMF_NONE || u->kind == ARMK_BARRIER)
+                return -1;
+            if (u->def & (1u << t))
+            {
+                if ((u->fmt == ARMF_MEM && u->kind != ARMK_LOAD) || u->kind == ARMK_STORE)
+                    return -1;
+                return j;                            /* read-modify-write ends the value */
+            }
+            last = j;
+        }
+        else if (u->def & (1u << t))
+            break;
+        if (u->kind == ARMK_BARRIER)
+            return -1;
+    }
+    if (j >= end && (liveOut & (1u << t)))
+        return -1;
+    if (liveAfter[last - start] & (1u << t))
+        return -1;
+    return last;
+}
+
+static void renameRange(ArmIns_s *ins, int from, int last, unsigned int t, unsigned int f)
+{
+    int j;
+    for (j = from; j <= last; ++j)
+        if (insReads(&ins[j]) & (1u << t))
+            renameReads(&ins[j], t, f);
+}
+
+static void forwardLoadsBlock(ArmIns_s *ins, int start, int end, unsigned short liveOut,
+                              unsigned short *liveAfter)
+{
+    int i, j, k;
+    computeLiveAfter(ins, start, end, liveOut, liveAfter);
+    for (j = start; j < end; ++j)
+    {
+        ArmIns_s *l2 = &ins[j];
+        unsigned int x, y, r;
+        int lastX, lastY, ok;
+        if (l2->kind != ARMK_LOAD || l2->cond != 14u || l2->memBase != 0 || l2->memImm < 0
+            || l2->fmt != ARMF_MEM || (l2->w & 0x0E000000u) != 0x04000000u)
+            continue;
+        x = (l2->w >> 12) & 15u;
+        if (((RENAMABLE >> x) & 1u) == 0)
+            continue;
+        /* find the previous load of the same slot */
+        for (i = j - 1; i >= start; --i)
+        {
+            const ArmIns_s *p = &ins[i];
+            if (p->kind == ARMK_BARRIER)
+            {
+                i = start - 1;
+                break;
+            }
+            if (p->kind == ARMK_STORE && p->memBase == 0 && (p->memImm < 0 || p->memImm == l2->memImm))
+            {
+                i = start - 1;
+                break;
+            }
+            if (p->kind == ARMK_LOAD && p->cond == 14u && ((p->w ^ l2->w) & 0xFFFF0FFFu) == 0)
+                break;
+        }
+        if (i < start)
+            continue;
+        y = (ins[i].w >> 12) & 15u;
+        if (((RENAMABLE >> y) & 1u) == 0)
+            continue;
+        lastX = valueRangeEnd(ins, j, end, liveOut, liveAfter, start, x);
+        if (lastX < 0)
+            continue;
+        if (lastX == j)
+        {
+            armDecode(l2, AS_NOP);                   /* unused load */
+            computeLiveAfter(ins, start, end, liveOut, liveAfter);
+            continue;
+        }
+        /* can y simply stay alive until lastX? */
+        ok = 1;
+        for (k = i + 1; k <= lastX; ++k)
+            if (k != j && (ins[k].def & (1u << y)))
+                ok = 0;
+        if (x == y && ok)
+        {
+            armDecode(l2, AS_NOP);
+            computeLiveAfter(ins, start, end, liveOut, liveAfter);
+            continue;
+        }
+        if (ok)
+        {
+            /* y also must not be read as a different value (it is not: no redef) */
+            renameRange(ins, j + 1, lastX, x, y);
+            armDecode(l2, AS_NOP);
+            computeLiveAfter(ins, start, end, liveOut, liveAfter);
+            continue;
+        }
+        /* merge both ranges onto a register free over [i, lastX] */
+        lastY = valueRangeEnd(ins, i, end, liveOut, liveAfter, start, y);
+        if (lastY < 0 || lastY >= j)
+            continue;
+        {
+            unsigned short busy = 0;
+            for (k = i; k <= lastX; ++k)
+                busy |= (unsigned short)(liveAfter[k - start] | ins[k].def | insReads(&ins[k]));
+            /* live into the first load */
+            busy |= (unsigned short)((liveAfter[i - start] & ~ins[i].def) | insReads(&ins[i]));
+            for (r = 1; r < 15; ++r)
+                if (((RENAMABLE >> r) & 1u) && ((busy >> r) & 1u) == 0)
+                    break;
+            if (r >= 15)
+                continue;
+            if (!renameDef(&ins[i], y, r))
+                continue;
+            renameRange(ins, i + 1, lastY, y, r);
+            renameRange(ins, j + 1, lastX, x, r);
+            armDecode(l2, AS_NOP);
+            computeLiveAfter(ins, start, end, liveOut, liveAfter);
+        }
+    }
+}
+
+static int compactCode(ArmIns_s *ins, int count, ArmBlock_s *blocks, int nBlocks,
+                       int *labelOffsets, int nLabels, int *newIndex)
+{
+    int i, b, out = 0;
+    for (i = 0; i < count; ++i)
+    {
+        newIndex[i] = out;
+        if (ins[i].w != AS_NOP)
+            ins[out++] = ins[i];
+    }
+    for (b = 0; b < nBlocks; ++b)
+        blocks[b].start = (blocks[b].start < count) ? newIndex[blocks[b].start] : out;
+    for (b = 0; b < nBlocks; ++b)
+        blocks[b].end = (b + 1 < nBlocks) ? blocks[b + 1].start : out;
+    for (i = 0; i < nLabels; ++i)
+    {
+        if (labelOffsets[i] >= 0 && labelOffsets[i] < count)
+            labelOffsets[i] = newIndex[labelOffsets[i]];
+        else if (labelOffsets[i] >= count)
+            labelOffsets[i] = out + (labelOffsets[i] - count);
+    }
+    return out;
+}
+
+/* --- driver -------------------------------------------------------------- */
+
+int HCARM_optimizeCode(void *scratch, int scratchSize, unsigned int *code, int count,
+                       const int *labelIds, int *labelOffsets, int nLabels,
+                       const int *usatHints, int nUsatHints, unsigned int flags)
+{
+    ArmIns_s *ins;
+    ArmBlock_s *blocks;
+    int *origIndex;
+    int *newIndex;
+    unsigned char *isLeader;
+    int nBlocks = 0;
+    int i, b, changed, out;
+    SchedWork_s *work;
+    size_t need = (size_t)count * (sizeof(ArmIns_s) + 2 * sizeof(int) + 1 + sizeof(ArmBlock_s))
+                + sizeof(SchedWork_s) + 64;
+
+    if (count <= 0 || need > (size_t)scratchSize)
+        return count;
+    ins = (ArmIns_s *)scratch;
+    blocks = (ArmBlock_s *)(ins + count);
+    origIndex = (int *)(blocks + count);
+    newIndex = origIndex + count;
+    isLeader = (unsigned char *)(newIndex + count);
+    work = (SchedWork_s *)(((size_t)(isLeader + count) + 7u) & ~(size_t)7u);
+
+    for (i = 0; i < count; ++i)
+    {
+        armDecode(&ins[i], code[i]);
+        origIndex[i] = i;
+        isLeader[i] = 0;
+    }
+    isLeader[0] = 1;
+    for (i = 0; i < nLabels; ++i)
+        if (labelOffsets[i] >= 0 && labelOffsets[i] < count)
+            isLeader[labelOffsets[i]] = 1;
+    for (i = 0; i < count; ++i)
+        if ((ins[i].kind == ARMK_BRANCH || ins[i].kind == ARMK_BARRIER) && i + 1 < count)
+            isLeader[i + 1] = 1;
+    for (i = 0; i < count; ++i)
+    {
+        if (isLeader[i])
+        {
+            if (nBlocks > 0)
+                blocks[nBlocks - 1].end = i;
+            blocks[nBlocks].start = i;
+            ++nBlocks;
+        }
+    }
+    blocks[nBlocks - 1].end = count;
+
+    /* CFG + liveness */
+    for (b = 0; b < nBlocks; ++b)
+    {
+        ArmBlock_s *bb = &blocks[b];
+        ArmIns_s *last = &ins[bb->end - 1];
+        unsigned short use = 0, def = 0;
+        bb->succ[0] = bb->succ[1] = -1;
+        for (i = bb->start; i < bb->end; ++i)
+        {
+            use |= (unsigned short)(insReads(&ins[i]) & ~def);
+            def |= ins[i].def;
+            if (ins[i].kind == ARMK_BARRIER)
+            {
+                /* prologue / epilogue: STM reads, LDM writes everything */
+                if ((ins[i].w & 0x00100000u) == 0)
+                    use |= (unsigned short)~def;
+                else
+                    def = 0xFFFFu;
+            }
+        }
+        bb->use = use;
+        bb->def = def;
+        bb->liveIn = bb->liveOut = 0;
+        if (last->kind == ARMK_BRANCH)
+        {
+            int target = labelTarget(labelIds, labelOffsets, nLabels, (int)(last->w & 0x00FFFFFFu));
+            bb->succ[0] = target >= 0 ? findBlock(blocks, nBlocks, target) : -1;
+            if (last->cond != 14u && b + 1 < nBlocks)
+                bb->succ[1] = b + 1;
+            if (target < 0)
+                return count;                        /* unknown label: leave code alone */
+        }
+        else if (last->kind == ARMK_BARRIER && (last->w & 0x00108000u) == 0x00108000u)
+        {
+            /* LDM ... pc: function exit */
+        }
+        else if (b + 1 < nBlocks)
+            bb->succ[0] = b + 1;
+    }
+    do
+    {
+        changed = 0;
+        for (b = nBlocks - 1; b >= 0; --b)
+        {
+            ArmBlock_s *bb = &blocks[b];
+            unsigned short out2 = 0, in2;
+            if (bb->succ[0] >= 0) out2 |= blocks[bb->succ[0]].liveIn;
+            if (bb->succ[1] >= 0) out2 |= blocks[bb->succ[1]].liveIn;
+            in2 = (unsigned short)(bb->use | (out2 & ~bb->def));
+            if (in2 != bb->liveIn || out2 != bb->liveOut)
+            {
+                bb->liveIn = in2;
+                bb->liveOut = out2;
+                changed = 1;
+            }
+        }
+    }
+    while (changed);
+
+    for (b = 0; b < nBlocks; ++b)
+    {
+        if ((flags & HCARM_OPT_PEEPHOLE) != 0)
+            peepholeBlock(ins, blocks[b].start, blocks[b].end, blocks[b].liveOut,
+                          usatHints, nUsatHints, origIndex);
+    }
+
+    /* drop removed words before scheduling (they would only constrain it) */
+    out = compactCode(ins, count, blocks, nBlocks, labelOffsets, nLabels, newIndex);
+
+    if ((flags & HCARM_OPT_FORWARD) != 0)
+    {
+        unsigned short *liveAfter = (unsigned short *)work->tmp;
+        for (b = 0; b < nBlocks; ++b)
+        {
+            int s0 = blocks[b].start, e0 = blocks[b].end;
+            while (s0 < e0)
+            {
+                int chunk = (e0 - s0 > SCHED_MAX) ? SCHED_MAX : e0 - s0;
+                forwardLoadsBlock(ins, s0, s0 + chunk,
+                                  s0 + chunk == e0 ? blocks[b].liveOut : 0xFFFFu, liveAfter);
+                s0 += chunk;
+            }
+        }
+    }
+
+    out = compactCode(ins, out, blocks, nBlocks, labelOffsets, nLabels, newIndex);
+
+    if ((flags & HCARM_OPT_RENAME) != 0)
+    {
+        unsigned short *liveAfter = (unsigned short *)work->tmp;  /* scratch reuse */
+        for (b = 0; b < nBlocks; ++b)
+        {
+            int s0 = blocks[b].start, e0 = blocks[b].end;
+            while (s0 < e0)
+            {
+                int chunk = (e0 - s0 > SCHED_MAX) ? SCHED_MAX : e0 - s0;
+                renameBlock(ins, s0, s0 + chunk,
+                            s0 + chunk == e0 ? blocks[b].liveOut : 0xFFFFu, liveAfter);
+                s0 += chunk;
+            }
+        }
+    }
+
+    if ((flags & HCARM_OPT_SCHEDULE) != 0)
+    {
+        for (b = 0; b < nBlocks; ++b)
+        {
+            int s = blocks[b].start, e = blocks[b].end;
+            if (e > s && ins[e - 1].kind == ARMK_BRANCH)
+                --e;                                  /* the branch stays last */
+            while (s < e)
+            {
+                int chunk = (e - s > SCHED_MAX) ? SCHED_MAX : e - s;
+                scheduleBlock(work, ins, s, s + chunk);
+                s += chunk;
+            }
+        }
+    }
+
+    for (i = 0; i < out; ++i)
+        code[i] = ins[i].w;
+    return out;
+}
