+/* Upper bound of an unsigned value (0xFFFFFFFF = unknown), following the
+ * UD chain through simple arithmetic (ARM11 work). */
+static unsigned int armRangeMax(HCInstr_s *instrs, int pc, void *info, int reg, int depth)
+{
+    void *ud;
+    int defPc;
+    HCInstr_s *def;
+    int op, hasImm;
+    unsigned int a, b;
+
+    if (depth > 6)
+        return 0xFFFFFFFFu;
+    ud = HC_getUDChain(info, pc, reg);
+    if (ud == NULL || HCChain_getLength(ud) != 1)
+        return 0xFFFFFFFFu;
+    defPc = HCChain_getValue(ud, 0);
+    if (defPc < 0 || defPc >= pc)
+        return 0xFFFFFFFFu;
+    def = &instrs[defPc];
+    op = HC_getOpcodeOper(def);
+    hasImm = (def->instr0 & 0x100u) != 0;
+    switch (op)
+    {
+    case HCOP_LBU: return 0xFFu;
+    case HCOP_LWU: return 0xFFFFu;
+    case HCOP_LSR:
+        if (hasImm)
+            return def->instr1 >= 32u ? 0u : (0xFFFFFFFFu >> def->instr1);
+        return 0xFFFFFFFFu;
+    case HCOP_AND:
+        if (hasImm)
+            return def->instr1;
+        a = armRangeMax(instrs, defPc, info, (int)(def->instr0 >> 21), depth + 1);
+        b = armRangeMax(instrs, defPc, info, (int)(def->instr1 & 0x7FFu), depth + 1);
+        return a < b ? a : b;
+    case HCOP_MOV:
+        if (hasImm)
+            return def->instr1;
+        return armRangeMax(instrs, defPc, info, (int)(def->instr0 >> 21), depth + 1);
+    case HCOP_MINU:
+    case HCOP_MINS:
+        if (hasImm && (int)def->instr1 >= 0)
+        {
+            a = armRangeMax(instrs, defPc, info, (int)(def->instr0 >> 21), depth + 1);
+            if (op == HCOP_MINU || a <= 0x7FFFFFFFu)
+                return a < def->instr1 ? a : def->instr1;
+        }
+        return 0xFFFFFFFFu;
+    case HCOP_ADD:
+    case HCOP_OR:
+    case HCOP_XOR:
+    case HCOP_MULU:
+    case HCOP_MULS:
+    {
+        unsigned long long r;
+        a = armRangeMax(instrs, defPc, info, (int)(def->instr0 >> 21), depth + 1);
+        b = hasImm ? def->instr1 : armRangeMax(instrs, defPc, info, (int)(def->instr1 & 0x7FFu), depth + 1);
+        if (op == HCOP_MULU || op == HCOP_MULS)
+            r = (unsigned long long)a * b;
+        else
+            r = (unsigned long long)a + b;  /* OR/XOR bounded by the sum */
+        return r > 0xFFFFFFFFull ? 0xFFFFFFFFu : (unsigned int)r;
+    }
+    case HCOP_LSL:
+        if (hasImm)
+        {
+            unsigned long long r;
+            a = armRangeMax(instrs, defPc, info, (int)(def->instr0 >> 21), depth + 1);
+            r = (unsigned long long)a << (def->instr1 & 31u);
+            return r > 0xFFFFFFFFull ? 0xFFFFFFFFu : (unsigned int)r;
+        }
+        return 0xFFFFFFFFu;
+    default:
+        return 0xFFFFFFFFu;
+    }
+}
