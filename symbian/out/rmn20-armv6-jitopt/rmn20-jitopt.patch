+#define HCARM_OPT_PEEPHOLE 1u
+#define HCARM_OPT_SCHEDULE 2u
+#define HCARM_OPT_RENAME   4u
+#define HCARM_OPT_FORWARD  8u
+
+/* Optimises code[0..count) in place (branch words still hold label ids)
+ * and remaps labelOffsets. usatHints lists word indices of USAT
+ * instructions whose source is "LSR #k of a value < 2^31". Returns the new
+ * word count. scratch must hold roughly 40 bytes per word + 8 KB; with less
+ * the code is returned unchanged. */
+int HCARM_optimizeCode(void *scratch, int scratchSize, unsigned int *code, int count,
+                       const int *labelIds, int *labelOffsets, int nLabels,
+                       const int *usatHints, int nUsatHints, unsigned int flags);
